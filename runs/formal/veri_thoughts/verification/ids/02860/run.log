  catch { set cex_len [get_property_info -prop $prop cex_length] }
  puts $fp_cex "$prop | cex | $cex_len"
}
[<embedded>] % foreach prop $ar_cex_props {
  set cex_len ""
  catch { set cex_len [get_property_info -prop $prop cex_length] }
  puts $fp_cex "$prop | ar_cex | $cex_len"
}
[<embedded>] % close $fp_cex
