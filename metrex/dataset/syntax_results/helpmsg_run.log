[<embedded>] % 
[<embedded>] % proc getenv_or_die {name} {
  if {![info exists ::env($name)] || [string trim $::env($name)] eq ""} {
    puts "ERROR: environment variable $name is not set"
    exit 2
  }
  return [string trim $::env($name)]
}
[<embedded>] % 
[<embedded>] % set codes_file [getenv_or_die "VERI_CODES_FILE"]
syntax_results/veri_codes.txt
[<embedded>] % set out_file   [getenv_or_die "VERI_OUT_FILE"]
syntax_results/veri_helpmsg_dump.txt
[<embedded>] % 
[<embedded>] % if {![file exists $codes_file]} {
  puts "ERROR: codes_file not found: $codes_file"
  exit 2
}
[<embedded>] % 
[<embedded>] % set fin  [open $codes_file r]
file43
[<embedded>] % set fout [open $out_file w]
file44
[<embedded>] % 
[<embedded>] % puts $fout "Jasper helpmsg dump"
[<embedded>] % puts $fout "Codes file: $codes_file"
[<embedded>] % puts $fout "============================================================"
[<embedded>] % 
[<embedded>] % set n_ok 0
0
[<embedded>] % set n_fail 0
0
[<embedded>] % 
[<embedded>] % while {[gets $fin line] >= 0} {
  set code [string trim $line]
  if {$code eq ""} { continue }

  puts "DEBUG: Processing $code"
  flush stdout

  puts $fout ""
  puts $fout "==== $code ================================================"

  # Get help message output directly using full code
  set rc [catch {help -message $code} result]

  if {$rc} {
    puts $fout "ERROR: help -message failed for $code"
    puts $fout "DETAIL: $result"
    incr n_fail
  } else {
    puts $fout "$result"
    incr n_ok
  }
}
