    puts "INFO: Using active-low reset expression: $RESET_EXPR"
    catch { reset -expression $RESET_EXPR }
  } else {
    puts "INFO: Using reset signal: $RESET_SIG"
    catch { reset $RESET_SIG }
  }
} else {
